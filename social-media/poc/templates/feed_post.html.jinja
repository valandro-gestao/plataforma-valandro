<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Post de teste — Valandro Gestão</title>
<link rel="stylesheet" href="{{ styles_css }}">
<style>
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    width: 1080px;
    height: 1080px;
    overflow: hidden;
  }
  .canvas {
    width: 1080px;
    height: 1080px;
    background-color: var(--surface-inverse);
    background-image: url('{{ hex_pattern }}');
    background-repeat: no-repeat;
    background-position: right -60px bottom -60px;
    background-size: 460px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 72px;
    font-family: var(--font-body);
  }
  .logo {
    height: 32px;
    display: block;
  }
  .content { max-width: 820px; }
  .kicker {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-on-inverse-muted);
    margin: 0 0 var(--space-6) 0;
  }
  .headline {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--text-on-inverse);
    margin: 0 0 var(--space-6) 0;
  }
  .body {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--text-on-inverse-muted);
    max-width: 780px;
    margin: 0;
  }
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .handle {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-on-inverse-muted);
  }
</style>
</head>
<body>
  <div class="canvas">
    <img class="logo" src="{{ logo_white }}" alt="Valandro Gestão">
    <div class="content">
      {% if kicker %}<p class="kicker">{{ kicker }}</p>{% endif %}
      <p class="headline">{{ headline }}</p>
      <p class="body">{{ body }}</p>
    </div>
    <div class="footer">
      <span class="handle">@valandrogestao</span>
    </div>
  </div>
</body>
</html>
