# Copie este arquivo para `.env` (nunca versionado) e preencha os valores reais localmente.
# Ver social-media/docs/POC.md para como obter cada credencial e como colar o token com segurança.

# --- Meta / Instagram (Fase A do PoC) ---
# Token de acesso do usuário do Instagram (Instagram Login para Empresas), gerado no
# Meta for Developers para o app "Valandro Social Media". Curto (1h) ou de longa duração
# (60 dias) — poc/check_setup.py valida qual é e avisa se precisar trocar.
INSTAGRAM_ACCESS_TOKEN=

# Opcionais nesta fase: não são usados pelos scripts do PoC (que resolvem a conta via
# GET /me com o próprio token), mas documentados aqui porque vão ser necessários quando
# a renovação automática de token for implementada (pós-PoC).
META_APP_ID=
META_APP_SECRET=

# --- Supabase (hospedagem da imagem renderizada, exigida pela API do Instagram) ---
# Preencher depois de criar o projeto Supabase (ver gap identificado em docs/POC.md).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=social-media-poc

# --- LinkedIn (Fase B — ainda não usado nesta etapa) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
